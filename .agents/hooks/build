#!/usr/bin/env bash
# Builds build/cap-compress.exe with build.cmd (the C# compiler that ships with Windows, .NET
# Framework 4.x) and prints "build-file: <path> <version>", as the pipeline expects.
# A Windows app, so it builds only on Windows.
set -euo pipefail
cd "$(dirname "$0")/../.."
# The version is 0.1.<build number>. agent-build pc and fallback.yml set BUILD_NUMBER.
n="${BUILD_NUMBER:?Set by agent-build pc and fallback.yml from .agents/build-number}"
[ "${OS:-}" = Windows_NT ] || { echo "cap-compress builds only on Windows." >&2; exit 1; }
cmd //c build.cmd
[ -f build/cap-compress.exe ] || { echo "build.cmd made no build/cap-compress.exe." >&2; exit 1; }
echo "build-file: build/cap-compress.exe 0.1.$n"
